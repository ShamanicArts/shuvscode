  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#5a5a68", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.template"],
      "settings": { "foreground": "#c89b56" }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": { "foreground": "#f59542" }
    },
    {
      "scope": ["constant.character", "constant.other"],
      "settings": { "foreground": "#ff5252" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "keyword.control"],
      "settings": { "foreground": "#c4151b", "fontStyle": "" }
    },
    {
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#9c9caa" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": { "foreground": "#ffb454" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": { "foreground": "#ff7a59" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#d6d6dc" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#d6d6dc", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this"],
      "settings": { "foreground": "#ff3b3b", "fontStyle": "italic" }
    },
    {
      "scope": ["entity.name.tag", "support.class.component"],
      "settings": { "foreground": "#ff7a59" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c89b56", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#ff3b3b", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold", "foreground": "#ffb454" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic", "foreground": "#c89b56" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#c89b56" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#4dd187" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff5252" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffb454" }
    },
    {
      "scope": ["meta.diff.header", "meta.diff.range"],
      "settings": { "foreground": "#6dbdff" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ff5252", "fontStyle": "underline" }
    },
    {
      "scope": ["punctuation.definition.string", "punctuation.definition.parameters", "punctuation.section"],
      "settings": { "foreground": "#6a6a78" }
    },
    {
      "scope": ["meta.brace", "meta.bracket"],
      "settings": { "foreground": "#9c9caa" }
    }
  ]
}
